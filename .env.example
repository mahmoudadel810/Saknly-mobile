# Copy to .env and adjust. Restart `npx expo start` after changes.

# Deployed API (default when unset)
EXPO_PUBLIC_API_URL=https://saknly-server-9air.vercel.app/api/saknly/v1
# Local Saknly-server from the Android emulator (the emulator can't reach localhost)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:<PORT>/api/saknly/v1
# Local Saknly-server from a physical phone on the same Wi-Fi
# EXPO_PUBLIC_API_URL=http://<your-LAN-IP>:<PORT>/api/saknly/v1

# Must match BEARER_KEY on the server
EXPO_PUBLIC_TOKEN_PREFIX=Saknly__
