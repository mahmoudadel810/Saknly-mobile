{
  "expo": {
    "name": "Saknly",
    "slug": "saknly-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saknly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.saknly.mobile",
      "supportsTablet": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E5E57",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saknly.mobile"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E5E57",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": ["ar", "en"]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IBMPlexSansArabic-Regular.ttf",
            "./assets/fonts/IBMPlexSansArabic-Medium.ttf",
            "./assets/fonts/IBMPlexSansArabic-SemiBold.ttf",
            "./assets/fonts/IBMPlexSansArabic-Bold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0E5E57",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج سكنلي إلى صورك لإضافتها إلى إعلان عقارك.",
          "cameraPermission": "يحتاج سكنلي إلى الكاميرا لتصوير عقارك للإعلان.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم سكنلي موقعك لتحديد مكان عقارك على الخريطة عندما تضيف إعلانًا وأنت فيه.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "70386cbf-d870-472e-84f6-47a3768a092b"
      }
    },
    "owner": "mahmoudadel810",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/70386cbf-d870-472e-84f6-47a3768a092b"
    }
  }
}
