{
  "expo": {
    "name": "Saknly",
    "slug": "saknly-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saknly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.saknly.mobile",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E5E57",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saknly.mobile"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E5E57",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": ["ar", "en"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج سكنلي إلى صورك لإضافتها إلى إعلان عقارك.",
          "cameraPermission": "يحتاج سكنلي إلى الكاميرا لتصوير عقارك للإعلان.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
